# Copy to .env and fill in. Not committed to git.
#
# Password gate (both required to enable it — leave both unset to run
# without auth). Generate with: node scripts/generate-password.js
APP_PASSWORD=
SESSION_SECRET=

# Turso (only needed to point local dev at a remote database instead of the
# local sqlite file in data/).
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Locks down /api/cron when triggering it manually outside of Vercel Cron.
# CRON_SECRET=
